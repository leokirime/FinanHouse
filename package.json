{
  "name": "finanhouse",
  "private": true,
  "version": "0.1.0",
  "description": "Controle financeiro doméstico do Finanhouse — monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "database/inspection"
  ],
  "scripts": {
    "clean": "node scripts/clean-build-artifacts.mjs",
    "build:domain": "npm run build --workspace=@finanhouse/domain --if-present",
    "predev:web": "npm run build:domain",
    "dev:web": "npm run dev --workspace=web",
    "predev:api": "npm run build:domain",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build:domain && npm run build --workspace=api --workspace=web --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "pretypecheck": "npm run build:domain",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:domain",
    "test": "npm run test --workspaces --if-present",
    "verify:runtime": "node scripts/verify-runtime-imports.mjs",
    "inspect:db": "tsx database/inspection/inspect-database.ts",
    "typecheck:inspect-db": "tsc -p database/inspection/tsconfig.json",
    "test:tls": "tsx database/inspection/test-tls.ts",
    "db:check": "npm run db:check --workspace=api",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:seed:dev": "npm run db:seed:dev --workspace=api",
    "db:audit:schema": "npm run db:audit:schema --workspace=api --",
    "db:audit:responsible-member": "npm run db:audit:responsible-member --workspace=api --",
    "db:smoke:repositories": "npm run db:smoke:repositories --workspace=api",
    "db:smoke:http": "npm run db:smoke:http --workspace=api",
    "typecheck:api-scripts": "npm run typecheck:scripts --workspace=api"
  }
}
