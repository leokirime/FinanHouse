{
  "name": "finanhouse",
  "private": true,
  "version": "0.1.0",
  "description": "Controle financeiro doméstico do Finanhouse — monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "inspect:db": "tsx database/inspection/inspect-database.ts",
    "typecheck:inspect-db": "tsc -p database/inspection/tsconfig.json"
  }
}
