# Infraestrutura de dados: Aiven for MySQL (a Clever Cloud deixou de ser a
# infraestrutura ativa — ver Docs/02_architecture/decisoes_tecnicas.md, DT-07).
# Preencher com valores reais apenas em apps/api/.env.local (nunca neste arquivo,
# nunca versionado). Nenhum valor real deve ser commitado.

# Provedor e ambiente
DATABASE_PROVIDER=aiven
DATABASE_ENV=development

# Conexão (preencher somente em apps/api/.env.local)
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=finanhouse_dev

# TLS — verify_identity é o único modo aceito; sem fallback permissivo
DATABASE_SSL_MODE=verify_identity

# Certificado CA — exatamente UMA das duas variáveis abaixo deve ser preenchida
# (nunca as duas ao mesmo tempo). O certificado em si nunca é versionado.
# Exemplo de caminho local (apenas ilustrativo, não criar nem versionar este arquivo):
#   DATABASE_CA_PATH=C:/Users/<usuario>/.finanhouse/aiven-ca.pem
DATABASE_CA_PATH=
# Alternativa para ambientes de deploy sem sistema de arquivos persistente:
DATABASE_CA_CERT_BASE64=

# Confirmação explícita exigida por scripts/db-migrate.ts antes de aplicar
# qualquer migration — sem isto, o script para antes de conectar.
CONFIRM_DATABASE_MIGRATION=false

# ---------------------------------------------------------------------------
# Runtime HTTP da API (Sessão 14, Bloco 01) — nenhum valor abaixo é segredo.
# Em development/test, ambas podem ficar vazias: a API cai para os padrões
# locais (bind 127.0.0.1, origens do Vite). Em produção (NODE_ENV=production),
# as duas são OBRIGATÓRIAS e nunca aceitam localhost/127.0.0.1 (fail closed —
# apps/api/src/config/http-bind-config.ts, apps/api/src/config/cors-config.ts).
# ---------------------------------------------------------------------------

# Host de bind do Fastify. Deixe vazio em development/test (usa 127.0.0.1).
# Em produção, use o host fornecido pela plataforma de hospedagem — em
# containers/PaaS normalmente "0.0.0.0".
HTTP_HOST=

# Porta HTTP. Deixe vazio para usar o padrão (3000) — a maioria das
# plataformas de deploy já injeta PORT automaticamente.
PORT=

# Origem(ns) pública(s) do frontend autorizadas a chamar a API via CORS,
# separadas por vírgula (ex.: https://app.exemplo.com). Deixe vazio em
# development/test (usa as origens locais do Vite). Obrigatório em produção.
CORS_ALLOWED_ORIGINS=
