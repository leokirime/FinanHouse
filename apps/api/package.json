{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed:dev": "tsx scripts/db-seed-dev.ts",
    "db:audit:schema": "tsx scripts/db-audit-schema.ts",
    "db:audit:responsible-member": "tsx scripts/db-audit-responsible-member-integrity.ts",
    "db:audit:category-budgets": "tsx scripts/db-audit-category-budgets.ts",
    "db:smoke:repositories": "tsx scripts/db-smoke-repositories.ts",
    "db:smoke:http": "tsx scripts/db-smoke-http.ts",
    "db:smoke:category-budgets": "tsx scripts/db-smoke-category-budgets.ts",
    "db:bootstrap:household": "tsx scripts/db-bootstrap-household.ts",
    "db:configure:initial-passwords": "tsx scripts/db-configure-initial-passwords.ts",
    "db:audit:auth-sessions": "tsx scripts/db-audit-auth-sessions.ts",
    "db:smoke:auth-sessions": "tsx scripts/db-smoke-auth-sessions.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@finanhouse/domain": "*",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "mysql2": "^3.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vitest": "^3.0.5"
  }
}
