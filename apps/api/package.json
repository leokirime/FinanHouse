{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed:dev": "tsx scripts/db-seed-dev.ts",
    "db:audit:schema": "tsx scripts/db-audit-schema.ts"
  },
  "dependencies": {
    "@finanhouse/domain": "*",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vitest": "^3.0.5"
  }
}
